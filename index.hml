<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><style>*{box-sizing:border-box;margin:0;padding:0;}html,body{width:100%;height:100%;overflow:hidden;background:transparent;}.banner{width:100%;height:100vh;overflow:hidden;position:relative;background:linear-gradient(180deg,#1a3a5c 0%,#2a5a3a 70%,#1a3a20 100%);}@keyframes fu{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}@keyframes gb{from{width:0;}to{width:55px;}}@keyframes drift{from{transform:translateX(-120px);}to{transform:translateX(820px);}}@keyframes raypulse{0%,100%{opacity:.08;}50%{opacity:.22;}}@keyframes rfall{0%{transform:translateY(-15px);opacity:.8;}100%{transform:translateY(150px);opacity:0;}}@keyframes eyepulse{0%,100%{opacity:.1;}50%{opacity:.6;}}@keyframes walk{from{transform:translateX(-80px);}to{transform:translateX(760px);}}@keyframes lfall{0%{transform:translateY(-20px) rotate(0deg);opacity:.8;}100%{transform:translateY(150px) rotate(180deg);opacity:0;}}@keyframes bfly{0%{transform:translateX(-60px) translateY(0);}50%{transform:translateX(400px) translateY(5px);}100%{transform:translateX(820px) translateY(0);}}@keyframes flap{from{transform:scaleY(1);}to{transform:scaleY(.3);}}@keyframes eflow{0%{transform:translateY(100px);opacity:0;}40%{opacity:.7;}100%{transform:translateY(-20px);opacity:0;}}@keyframes nodepulse{0%,100%{transform:scale(1);opacity:.4;}50%{transform:scale(1.5);opacity:.8;}}@keyframes smokerise{0%{transform:translateY(0) scale(1);opacity:.5;}100%{transform:translateY(-90px) scale(2.5);opacity:0;}}@keyframes crackpulse{0%,100%{opacity:.2;}50%{opacity:.6;}}@keyframes wdrop{0%{transform:translateY(-10px);opacity:0;}20%{opacity:.8;}80%{opacity:.8;}100%{transform:translateY(110px);opacity:0;}}@keyframes cring{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}@keyframes twinkle{0%,100%{opacity:.1;transform:scale(1);}50%{opacity:.9;transform:scale(1.4);}}@keyframes linkpulse{0%,100%{opacity:.1;}50%{opacity:.5;}}.cloud{position:absolute;background:rgba(255,255,255,.18);border-radius:50px;}.ray{position:absolute;top:0;width:18px;transform-origin:top center;animation:raypulse 3s ease-in-out infinite;}.rdrop{position:absolute;width:1.5px;border-radius:2px;background:rgba(140,200,255,.7);animation:rfall linear infinite;}.animal{position:absolute;animation:walk linear infinite;}.eye-glow{position:absolute;border-radius:50%;animation:eyepulse 2.5s ease-in-out infinite;}.leaf-fall{position:absolute;animation:lfall linear infinite;}.butterfly{position:absolute;animation:bfly linear infinite;}.bwing{animation:flap .3s ease-in-out infinite alternate;}.energy-bar{position:absolute;left:0;animation:eflow linear infinite;}.node{position:absolute;border-radius:50%;animation:nodepulse 2s ease-in-out infinite;}.smoke{position:absolute;border-radius:50%;animation:smokerise ease-in-out infinite;}.crack{position:absolute;background:rgba(255,60,20,.3);animation:crackpulse 2s ease-in-out infinite;}.waterdrop{position:absolute;animation:wdrop ease-in-out infinite;}.cycle-ring{position:absolute;border-radius:50%;border:2px solid rgba(68,200,255,.25);animation:cring linear infinite;}.star{position:absolute;border-radius:50%;animation:twinkle ease-in-out infinite;}.link-line{position:absolute;height:1px;background:rgba(180,140,255,.3);animation:linkpulse 3s ease-in-out infinite;}.tw{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;z-index:10;white-space:nowrap;}.ey{font-family:Georgia,serif;font-size:9px;letter-spacing:4px;text-transform:uppercase;color:rgba(126,207,110,.85);margin-bottom:5px;animation:fu .8s ease both;}.mt{font-family:Georgia,serif;font-weight:700;color:#fff;font-size:36px;line-height:1.1;animation:fu .8s ease .15s both;text-shadow:0 2px 20px rgba(0,0,0,.8);}.mt span{color:#64c8ff;}.br{height:2.5px;background:#64c8ff;border-radius:2px;margin:6px auto 0;animation:gb 1s ease .3s both;}</style></head><body><div class="banner"><div class="ray" style="left:30%;height:160px;background:linear-gradient(rgba(255,220,80,.15),transparent);animation-delay:0s;transform:rotate(-15deg);"></div><div class="ray" style="left:46%;height:160px;background:linear-gradient(rgba(255,220,80,.12),transparent);animation-delay:1s;transform:rotate(0deg);width:14px;"></div><div class="cloud" style="width:80px;height:22px;top:15%;animation-duration:18s;animation-delay:0s;"></div><div class="cloud" style="width:55px;height:16px;top:28%;animation-duration:24s;animation-delay:-8s;"></div><div class="cloud" style="width:100px;height:26px;top:10%;animation-duration:30s;animation-delay:-15s;"></div><div class="rdrop" style="left:8%;height:12px;animation-duration:1.1s;animation-delay:0s;"></div><div class="rdrop" style="left:20%;height:10px;animation-duration:.9s;animation-delay:.3s;"></div><div class="rdrop" style="left:50%;height:14px;animation-duration:1.2s;animation-delay:.6s;"></div><div class="rdrop" style="left:75%;height:11px;animation-duration:1s;animation-delay:.2s;"></div><div class="rdrop" style="left:90%;height:13px;animation-duration:1.1s;animation-delay:.5s;"></div><div class="tw"><div class="ey">Tropical Rainforest</div><div class="mt">☁️ <span>Climate</span></div><div class="br"></div></div></div></body></html>
